---
import Base from '../../layouts/Base.astro';
import EntryList from '../../components/EntryList.astro';
import { getPublished } from '../../lib/content';

const entries = await getPublished('talks');
const title = 'Speaking';
const intro = 'Talks, panels, podcasts and workshops on AI-native software delivery, spec-driven development and enterprise telemetry.';
---

<Base title={title} description={intro} breadcrumbs={[{ name: title, url: '/speaking/' }]}>
  <section class="container section">
    <h1>{title}</h1>
    <p class="prose muted">{intro}</p>
    <EntryList entries={entries} showType={false} />
  </section>
</Base>
