---
import Base from '../../layouts/Base.astro';
import EntryList from '../../components/EntryList.astro';
import { getPublished } from '../../lib/content';

const entries = await getPublished('caseStudies');
const title = 'Case Studies';
const intro = 'Outcome stories from enterprise delivery: the problem, the approach, the measurable result and the lessons.';
---

<Base title={title} description={intro} breadcrumbs={[{ name: title, url: '/case-studies/' }]}>
  <section class="container section">
    <h1>{title}</h1>
    <p class="prose muted">{intro}</p>
    <EntryList entries={entries} showType={false} />
  </section>
</Base>
