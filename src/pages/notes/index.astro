---
import Base from '../../layouts/Base.astro';
import EntryList from '../../components/EntryList.astro';
import { getPublished } from '../../lib/content';

const entries = await getPublished('notes');
const title = 'Field Notes';
const intro = 'Short observations, lessons and links from practice — AI-native delivery, telemetry and usage monetization.';
---

<Base title={title} description={intro} breadcrumbs={[{ name: title, url: '/notes/' }]}>
  <section class="container section">
    <h1>{title}</h1>
    <p class="prose muted">{intro}</p>
    <EntryList entries={entries} showType={false} />
  </section>
</Base>
